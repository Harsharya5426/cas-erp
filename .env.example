# ==============================================================================
# CAS ERP Environment Template — Copy to .env for local development ONLY.
# NEVER commit .env or production secrets to version control.
# ==============================================================================

NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/cas_erp_dev

# JWT & Session Secrets (Replace with strong 64+ char random strings locally / AWS Secrets Manager in prod)
JWT_ACCESS_SECRET=replace_with_dev_only_access_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_dev_only_refresh_secret_min_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
COOKIE_SECURE=false

# Object Storage (local | s3)
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=./storage
AWS_REGION=ap-south-1
S3_BUCKET_NAME=

# Cashfree Payments Adapter (sandbox | production | disabled)
CASHFREE_MODE=disabled
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_API_VERSION=2023-08-01

# Communications Adapters (disabled | log | provider)
EMAIL_PROVIDER=disabled
SMS_PROVIDER=disabled
WHATSAPP_PROVIDER=disabled

# Identity SSO Adapters (disabled until institutional tenant approval)
GOOGLE_SSO_ENABLED=false
GOOGLE_CLIENT_ID=
MICROSOFT_SSO_ENABLED=false
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=

# Biometric & AI Governance Gates
BIOMETRIC_POLICY_APPROVED=false
AI_ASSISTANT_ENABLED=true
ML_SERVICE_URL=http://127.0.0.1:8001
ML_SERVICE_TOKEN=replace_with_dev_internal_ml_token

